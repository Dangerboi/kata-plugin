{
  "name": "kata-plugin",
  "version": "1.12.2",
  "private": true,
  "type": "module",
  "description": "Kata work tracking for oh-my-pi, pi and OpenCode",
  "license": "MIT",
  "author": "Dangerboi",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "plugins/*"
  ],
  "pi": {
    "extensions": [
      "./plugins/pi/kata.ts"
    ]
  },
  "scripts": {
    "test": "bun tests/run.ts all",
    "smoke:omp": "bun scripts/vendor-core.ts --check && bun scripts/smoke-omp.ts",
    "smoke:opencode": "bun scripts/vendor-core.ts --check && bun scripts/smoke-opencode.ts",
    "smoke:claude": "bun scripts/vendor-core.ts --check && bun scripts/smoke-claude.ts",
    "smoke:omp-attention": "bun scripts/vendor-core.ts --check && bun scripts/smoke-omp-attention.ts",
    "test:files": "bun tests/run.ts",
    "test:changed": "bun tests/run.ts changed",
    "test:revisions": "bun tests/run.ts revisions",
    "build:plugins": "bun scripts/vendor-core.ts",
    "check:plugins": "bun scripts/vendor-core.ts --check",
    "validate:claude": "claude plugin validate . && claude plugin validate plugins/claude-code",
    "test:claude": "claude plugin test plugins/claude-code",
    "typecheck": "tsc -p tsconfig.json && tsc -p plugins/claude-code/tsconfig.json && tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/bun": "1.4.4",
    "@types/node": "25.9.2",
    "typescript": "7.0.2",
    "typebox": "1.3.27",
    "fast-check": "^4.3.0",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta"
  }
}
