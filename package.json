{
  "name": "kata-plugin",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Kata work tracking for oh-my-pi and pi",
  "license": "MIT",
  "author": "Dangerboi",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "plugins/*"
  ],
  "pi": {
    "extensions": [
      "./plugins/pi/kata.ts"
    ]
  },
  "scripts": {
    "test": "bun tests/run.ts all",
    "smoke:omp": "bun scripts/smoke-omp.ts",
    "test:todo": "bun tests/run.ts",
    "test:revisions": "bun tests/run.ts revisions",
    "build:plugins": "bun scripts/vendor-core.ts",
    "check:plugins": "bun scripts/vendor-core.ts --check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "25.9.2",
    "typescript": "5.9.3",
    "typebox": "1.3.27",
    "fast-check": "^4.3.0"
  }
}
