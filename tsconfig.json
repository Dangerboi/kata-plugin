{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ]
  },
  "include": [
    "core/**/*.ts",
    "plugins/oh-my-pi/*.ts",
    "plugins/pi/*.ts",
    "plugins/opencode/*.ts"
  ]
}
